# Configuración de Firebase para el Piloto (Secretaría de Producción Tinogasta)
# Copiar este archivo como .env.local y completar con los datos de Firebase Console:
# Consola: https://console.firebase.google.com/ -> Configuración del Proyecto -> General -> Tus apps (Web)

VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_proyecto_id
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
VITE_FIREBASE_APP_ID=tu_app_id

# Webhook de Google Apps Script (Hoja REGISTRO en Google Sheets)
# Se obtiene luego de desplegar el script en Extensiones > Apps Script como Aplicación Web
VITE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/TU_SCRIPT_ID/exec

